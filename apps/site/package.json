    "fumadocs-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "^19.3.0",
    "svgl-react": "catalog:",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-238e489d5",
    "@dotenvx/dotenvx": "catalog:",
    "@evertap/config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
