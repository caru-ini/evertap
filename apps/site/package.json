    "type": "git",
    "url": "git+https://github.com/caru-ini/evertap.git",
    "directory": "apps/site"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "check-types": "rm -rf .css-types && tcm -a -s -p \"{app,components,lib}/**/*.module.css\" -o .css-types . && tsc --noEmit",
    "test": "vitest run",
    "deploy": "dotenvx run -f .env.production -- vinext-cloudflare deploy"
  },
  "dependencies": {
    "@evertap/api": "workspace:*",
    "@evertap/ui": "workspace:*",
    "@phosphor-icons/react": "catalog:",
