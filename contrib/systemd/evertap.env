# Copy to /etc/evertap/evertap.env for evertap@.service. Set only what you need: a value here
# overrides what evertap would use otherwise.

# How browsers reach evertap: network (your home network, or your own reverse proxy), cloudflare,
# or local. Unset, evertap listens on 127.0.0.1 alone.
#EVERTAP_MODE=network

# Where the UI listens: 127.0.0.1 behind a proxy on this machine, 0.0.0.0 for your home network.
#EVERTAP_LISTEN_HOST=0.0.0.0

# Docker's socket, when it is not /var/run/docker.sock.
#EVERTAP_DOCKER_SOCKET=/var/run/docker.sock

# Where browsers open evertap, such as an address behind your reverse proxy. Sign-in links point here.
#EVERTAP_PUBLIC_URL=https://evertap.example.com

# The port the UI listens on.
#EVERTAP_PORT=8080

# 0 stops evertap from asking GitHub once a day whether a newer release is out.
#EVERTAP_UPDATE_CHECK=0
