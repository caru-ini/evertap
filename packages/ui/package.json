    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@evertap/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typed-css-modules": "catalog:",
    "typescript": "catalog:"
  }
}
